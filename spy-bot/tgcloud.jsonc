{
  // Mini App: папка сборки (npm run build) и настройки раздачи.
  "static": {
    "source": "dist",
    // Файлы маленькие и без хешей в именах — пусть браузер каждый раз сверяется,
    // иначе после правки расписания приложение может показывать старое.
    "headers": [{ "path": "/*", "set": { "Cache-Control": "no-cache" } }]
  },
  "$schema": "./node_modules/@tgcloud/cli/schema/tgcloud.json"
}
